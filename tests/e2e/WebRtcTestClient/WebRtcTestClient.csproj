<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only SIPSorcery is needed: this client never decodes video, it just counts arriving RTP
         packets over the peer connection to prove the media stream is flowing, so
         SIPSorceryMedia.FFmpeg (a decode/encode codec provider) is not required. -->
    <PackageReference Include="SIPSorcery" Version="10.0.11" />
  </ItemGroup>

</Project>
